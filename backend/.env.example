# Phygital - Cash-Flow Engine Backend Configuration
# Copy this file to .env and fill in real values for production.

SECRET_KEY=your_secret_key_here
REDIS_URL=redis://localhost:6379/0
BASE_URL=https://phygital.lk
DEBUG=true
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ALLOWED_ORIGINS=["https://phygital.lk"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OFFICER_CREDENTIALS={"username":"password"}
